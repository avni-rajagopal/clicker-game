--- !u!114 &989887211
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 989887209}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 92dca20bba49443a086c32af58847e4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  triggerAltitude: 125
  lines:
  - Who dares approach?
  - A kee-hwi, you say?
  - How unbearably quaint. Your drab plumage assaults my retinas.
  - Begone, you slovenly earth-bound rat!!!
  - ...
  - "\u2026..."
  - "Oh, ha-ha\u2026"
  - It appears the game makers ran out of time to implement my vaporizing abilities.
  - How awkward.
  - "Well, until they get around to it\u2026 "
  - "I shall simply have to thwart your ascent\u2026"
  - With my mental powers!
  text: {fileID: 1225829124}
  obstacle: {fileID: 2045339412}
  onFinished:
    m_PersistentCalls:
      m_Calls: []
  letterDelay: 0.03
